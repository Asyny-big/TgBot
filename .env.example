# =============================================================================
# Telegram Digital Shop — environment template.
# Copy to .env and fill every value. The process refuses to start on bad input.
#   cp .env.example .env
# =============================================================================

# --------------------------------- Application -------------------------------
APP_NAME=Telegram Digital Shop
# local | testing | production
APP_ENVIRONMENT=local
# Must be false when APP_ENVIRONMENT=production
APP_DEBUG=true
# DEBUG | INFO | WARNING | ERROR | CRITICAL
APP_LOG_LEVEL=INFO
# json (production) | console (local development)
APP_LOG_FORMAT=console
APP_API_PREFIX=/api/v1
# Swagger UI is always off in production, regardless of this flag
APP_DOCS_ENABLED=true
APP_HOST=0.0.0.0
APP_PORT=8000

# ---------------------------------- PostgreSQL -------------------------------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=tgshop
POSTGRES_PASSWORD=change-me-postgres-password
POSTGRES_DB=tgshop
POSTGRES_POOL_SIZE=10
POSTGRES_MAX_OVERFLOW=10
# Seconds to wait for a free pooled connection
POSTGRES_POOL_TIMEOUT=30
# Recycle pooled connections after this many seconds
POSTGRES_POOL_RECYCLE=1800
# Logs every SQL statement — keep false outside debugging sessions
POSTGRES_ECHO=false
# Host port used by docker-compose to expose the database locally
POSTGRES_EXPOSED_PORT=5432

# ------------------------------------- Redis ---------------------------------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
# May be empty in the development stack. REQUIRED in production: the production
# compose file starts Redis with --requirepass and refuses to come up without it.
# openssl rand -hex 24
REDIS_PASSWORD=
REDIS_MAX_CONNECTIONS=20
REDIS_SOCKET_TIMEOUT=5
# Distributed locks expire automatically after this many seconds (5-300)
REDIS_LOCK_TTL_SECONDS=45
# How long to wait for a busy lock before giving up (0 = fail fast)
REDIS_LOCK_WAIT_SECONDS=0
REDIS_EXPOSED_PORT=6379

# ----------------------------------- Telegram --------------------------------
# From @BotFather
TELEGRAM_BOT_TOKEN=123456789:AAaaBBbbCCccDDddEEeeFFffGGgghhhh000
# Bot username without '@' — used to build deep links
TELEGRAM_BOT_USERNAME=MyShopBot
# true in production (behind nginx + TLS), false for local long polling
TELEGRAM_USE_WEBHOOK=false
# Public HTTPS origin of the deployment, required when TELEGRAM_USE_WEBHOOK=true
TELEGRAM_WEBHOOK_BASE_URL=
TELEGRAM_WEBHOOK_PATH=/webhook/telegram
# Sent by Telegram as X-Telegram-Bot-Api-Secret-Token, min 16 chars
TELEGRAM_WEBHOOK_SECRET=change-me-webhook-secret
TELEGRAM_DROP_PENDING_UPDATES=true

# ---------------------------------- CryptoBot --------------------------------
# From @CryptoBot -> Crypto Pay -> Create App
CRYPTOBOT_API_TOKEN=00000:AAaaBBbbCCccDDddEEeeFFff
# mainnet | testnet
CRYPTOBOT_NETWORK=mainnet
CRYPTOBOT_ASSET=USDT
CRYPTOBOT_INVOICE_TTL_SECONDS=1800
# HTTP timeout for Crypto Pay API calls, seconds
CRYPTOBOT_REQUEST_TIMEOUT=15
# Path nginx forwards Crypto Pay webhooks to (must match the app you created)
CRYPTOBOT_WEBHOOK_PATH=/webhook/cryptobot

# ------------------------------------- Bot -----------------------------------
# The bot process serves Telegram and CryptoBot webhooks on this address
BOT_WEBHOOK_HOST=0.0.0.0
BOT_WEBHOOK_PORT=8081
# Anti-flood window per buyer, seconds
BOT_THROTTLE_SECONDS=1.5
# How often unpaid crypto invoices are re-checked against the provider
BOT_RECONCILIATION_INTERVAL_SECONDS=60
BOT_RECONCILIATION_BATCH_SIZE=50
# How often stale pending purchases are expired
BOT_HOUSEKEEPING_INTERVAL_SECONDS=300

# ----------------------------------- Delivery --------------------------------
# Retry policy for sending the purchased link to the buyer
DELIVERY_MAX_ATTEMPTS=4
DELIVERY_INITIAL_BACKOFF_SECONDS=1
DELIVERY_MAX_BACKOFF_SECONDS=20
DELIVERY_BACKOFF_MULTIPLIER=2
DELIVERY_JITTER_RATIO=0.25

# ----------------------------------- Security --------------------------------
# openssl rand -hex 32
SECURITY_JWT_SECRET=change-me-with-openssl-rand-hex-32-at-least-32-chars
SECURITY_JWT_ALGORITHM=HS256
SECURITY_ACCESS_TOKEN_TTL_MINUTES=15
SECURITY_REFRESH_TOKEN_TTL_DAYS=14
SECURITY_ADMIN_USERNAME=admin
# Min 12 chars — hashed with argon2 in memory, never stored in plain text
SECURITY_ADMIN_PASSWORD=change-me-admin-password
# Login attempts allowed per window, and the window length in seconds
SECURITY_LOGIN_RATE_LIMIT=10
SECURITY_LOGIN_RATE_WINDOW_SECONDS=300
# Set to false only for plain-HTTP local development
SECURITY_COOKIE_SECURE=true
SECURITY_COOKIE_NAME=tgshop_refresh
# Comma separated origins allowed to call the admin API from a browser.
# Needed only by the Vite dev server. In production the panel is served from the
# same origin as the API, so leave this EMPTY — every value here is a domain you
# are granting access to the admin API.
SECURITY_CORS_ORIGINS=http://localhost:5173

# -------------------------------- Local exposure -----------------------------
# Development only: the production stack publishes nothing but 80 and 443.
API_EXPOSED_PORT=8000
BOT_EXPOSED_PORT=8081
ADMIN_EXPOSED_PORT=8080

# ===================================================================== #
# Production only. Ignored by the development stack.
# ===================================================================== #

# ------------------------------------- Edge ----------------------------------
# Bare host name, no scheme and no trailing slash. nginx serves this name, and
# the TLS certificate is issued for it. TELEGRAM_WEBHOOK_BASE_URL must be
# exactly https://<this value> — scripts/preflight.sh checks that they agree.
TGSHOP_DOMAIN=shop.example.com
# Let's Encrypt uses this address only for expiry warnings.
TGSHOP_ACME_EMAIL=admin@example.com

# ------------------------------------- API -----------------------------------
# Uvicorn worker processes. Each one opens its own connection pool, so keep
# API_WORKERS x (POSTGRES_POOL_SIZE + POSTGRES_MAX_OVERFLOW) below the database's
# max_connections. Two is right for a 2-4 vCPU box.
API_WORKERS=2
