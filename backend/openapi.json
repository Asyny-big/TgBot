{
  "openapi": "3.1.0",
  "info": {
    "title": "Telegram Digital Shop",
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/health/live": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Liveness probe",
        "description": "Report that the process is running.",
        "operationId": "liveness_api_v1_health_live_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/LivenessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/health/ready": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Readiness probe",
        "description": "Probe PostgreSQL and Redis, answering 503 when any of them is down.",
        "operationId": "readiness_api_v1_health_ready_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReadinessResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/login": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Exchange credentials for tokens",
        "description": "Authenticate the administrator.\n\nRaises:\n    TooManyLoginAttemptsError: the rate limit for this client was exceeded.\n    AuthenticationError: wrong username or password.",
        "operationId": "login_api_v1_auth_login_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/LoginRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/refresh": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Rotate the refresh token",
        "description": "Issue a new token pair and invalidate the presented refresh token.\n\nRaises:\n    InvalidTokenError: no token supplied, or it is invalid, expired or revoked.",
        "operationId": "refresh_api_v1_auth_refresh_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/TokenResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/logout": {
      "post": {
        "tags": [
          "auth"
        ],
        "summary": "Revoke the refresh token",
        "description": "Revoke the refresh token and clear the cookie. Idempotent for a stale token.",
        "operationId": "logout_api_v1_auth_logout_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "anyOf": [
                  {
                    "$ref": "#/components/schemas/RefreshRequest"
                  },
                  {
                    "type": "null"
                  }
                ],
                "title": "Payload"
              }
            }
          }
        },
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/auth/me": {
      "get": {
        "tags": [
          "auth"
        ],
        "summary": "Who am I",
        "description": "Return the authenticated administrator.",
        "operationId": "me_api_v1_auth_me_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/AdminResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    },
    "/api/v1/products": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "List products",
        "description": "Paginated products, newest first, with search and an activity filter.",
        "operationId": "list_products_api_v1_products_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "name": "is_active",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "boolean"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Is Active"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse_ProductResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "products"
        ],
        "summary": "Create a product",
        "description": "Create a product and return it with its deep link.\n\nRaises:\n    SlugAlreadyExistsError: the slug is taken.\n    InvalidDeliveryUrlError: the delivery link is not an absolute http(s) URL.",
        "operationId": "create_product_api_v1_products_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductCreateRequest"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/products/{product_id}": {
      "get": {
        "tags": [
          "products"
        ],
        "summary": "Read a product",
        "description": "Read one product.\n\nRaises:\n    ProductNotFoundError: no product with this id.",
        "operationId": "get_product_api_v1_products__product_id__get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "patch": {
        "tags": [
          "products"
        ],
        "summary": "Update a product",
        "description": "Apply a partial update.\n\nOnly fields present in the request body are touched; sending ``null`` for a\nnullable field clears it.\n\nRaises:\n    ProductNotFoundError: no product with this id.\n    InvalidPriceError: the update would leave the product with no price.\n    SlugAlreadyExistsError: the new slug is taken.",
        "operationId": "update_product_api_v1_products__product_id__patch",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Product Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ProductPatchRequest"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ProductResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "delete": {
        "tags": [
          "products"
        ],
        "summary": "Delete a product that was never sold",
        "description": "Delete a product.\n\nRaises:\n    ProductNotFoundError: no product with this id.\n    ConflictError: the product has purchases; deactivate it instead.",
        "operationId": "delete_product_api_v1_products__product_id__delete",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "product_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Product Id"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Successful Response"
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/purchases": {
      "get": {
        "tags": [
          "purchases"
        ],
        "summary": "Search purchases",
        "description": "Search by Telegram id, username, product title or slug, invoice or charge id.",
        "operationId": "search_purchases_api_v1_purchases_get",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "search",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 255
                },
                {
                  "type": "null"
                }
              ],
              "title": "Search"
            }
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "array",
                  "items": {
                    "$ref": "#/components/schemas/PurchaseStatus"
                  }
                },
                {
                  "type": "null"
                }
              ],
              "title": "Status"
            }
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Limit"
            }
          },
          {
            "name": "offset",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "default": 0,
              "title": "Offset"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/PageResponse_PurchaseRecordResponse_"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/purchases/{purchase_id}/verify": {
      "post": {
        "tags": [
          "purchases"
        ],
        "summary": "Check a payment manually and finish it if needed",
        "description": "Re-check one purchase against the payment provider.\n\nFor the support case \"I paid but got no link\". Idempotent:\n\n* already delivered → reports that, sends nothing;\n* paid but undelivered → retries delivery;\n* pending → asks CryptoBot for the invoice state, or uses the stored Telegram\n  charge id, and settles the payment when it is confirmed;\n* unpaid, expired or refunded → reported as-is, never \"fixed\".\n\nRaises:\n    PurchaseNotFoundError: no purchase with this id.\n    LockBusyError: a payment or delivery for it is already being processed.",
        "operationId": "verify_payment_api_v1_purchases__purchase_id__verify_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "purchase_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Purchase Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/VerificationResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/purchases/{purchase_id}/resend": {
      "post": {
        "tags": [
          "purchases"
        ],
        "summary": "Send the purchased link again",
        "description": "Re-send the link of an already paid purchase.\n\nRaises:\n    PurchaseNotFoundError: no purchase with this id.\n    ConflictError: the purchase is not paid.\n    LockBusyError: a delivery for it is already running.",
        "operationId": "resend_delivery_api_v1_purchases__purchase_id__resend_post",
        "security": [
          {
            "HTTPBearer": []
          }
        ],
        "parameters": [
          {
            "name": "purchase_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid",
              "title": "Purchase Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/DeliveryAttemptResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/stats/overview": {
      "get": {
        "tags": [
          "stats"
        ],
        "summary": "Dashboard overview",
        "description": "Today / week / month / all-time revenue, top products and last sales.",
        "operationId": "overview_api_v1_stats_overview_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/OverviewResponse"
                }
              }
            }
          }
        },
        "security": [
          {
            "HTTPBearer": []
          }
        ]
      }
    }
  },
  "components": {
    "schemas": {
      "AdminResponse": {
        "properties": {
          "username": {
            "type": "string",
            "title": "Username"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username"
        ],
        "title": "AdminResponse",
        "description": "Who the caller is."
      },
      "BuyerResponse": {
        "properties": {
          "telegram_id": {
            "type": "integer",
            "title": "Telegram Id"
          },
          "username": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Username"
          },
          "first_name": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "First Name"
          },
          "display_name": {
            "type": "string",
            "title": "Display Name"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "telegram_id",
          "username",
          "first_name",
          "display_name"
        ],
        "title": "BuyerResponse",
        "description": "The buyer, as shown in listings and search results."
      },
      "Currency": {
        "type": "string",
        "enum": [
          "XTR",
          "USDT"
        ],
        "title": "Currency",
        "description": "Currencies the shop can charge in."
      },
      "DeliveryAttemptResponse": {
        "properties": {
          "status": {
            "$ref": "#/components/schemas/DeliveryStatus"
          },
          "attempts": {
            "type": "integer",
            "title": "Attempts"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "status",
          "attempts",
          "error"
        ],
        "title": "DeliveryAttemptResponse",
        "description": "Outcome of the delivery attempt triggered by an admin action."
      },
      "DeliveryStatus": {
        "type": "string",
        "enum": [
          "sent",
          "already_delivered",
          "failed"
        ],
        "title": "DeliveryStatus",
        "description": "Outcome of one delivery attempt sequence."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "LivenessResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "alive",
            "title": "Status"
          },
          "version": {
            "type": "string",
            "title": "Version"
          }
        },
        "type": "object",
        "required": [
          "status",
          "version"
        ],
        "title": "LivenessResponse",
        "description": "Answered as long as the process can serve HTTP."
      },
      "LoginRequest": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 64,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 256,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "LoginRequest",
        "description": "Administrator credentials."
      },
      "OverviewResponse": {
        "properties": {
          "today": {
            "$ref": "#/components/schemas/RevenueResponse"
          },
          "week": {
            "$ref": "#/components/schemas/RevenueResponse"
          },
          "month": {
            "$ref": "#/components/schemas/RevenueResponse"
          },
          "total": {
            "$ref": "#/components/schemas/RevenueResponse"
          },
          "top_products": {
            "items": {
              "$ref": "#/components/schemas/TopProductResponse"
            },
            "type": "array",
            "title": "Top Products"
          },
          "recent_purchases": {
            "items": {
              "$ref": "#/components/schemas/PurchaseRecordResponse"
            },
            "type": "array",
            "title": "Recent Purchases"
          },
          "products_total": {
            "type": "integer",
            "title": "Products Total"
          },
          "products_active": {
            "type": "integer",
            "title": "Products Active"
          },
          "users_total": {
            "type": "integer",
            "title": "Users Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "today",
          "week",
          "month",
          "total",
          "top_products",
          "recent_purchases",
          "products_total",
          "products_active",
          "users_total"
        ],
        "title": "OverviewResponse",
        "description": "Everything the dashboard renders."
      },
      "PageMeta": {
        "properties": {
          "total": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Total"
          },
          "limit": {
            "type": "integer",
            "maximum": 100.0,
            "minimum": 1.0,
            "title": "Limit"
          },
          "offset": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Offset"
          },
          "has_more": {
            "type": "boolean",
            "title": "Has More"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "total",
          "limit",
          "offset",
          "has_more"
        ],
        "title": "PageMeta",
        "description": "Pagination envelope shared by every listing endpoint."
      },
      "PageResponse_ProductResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/ProductResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "meta"
        ],
        "title": "PageResponse[ProductResponse]"
      },
      "PageResponse_PurchaseRecordResponse_": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/PurchaseRecordResponse"
            },
            "type": "array",
            "title": "Items"
          },
          "meta": {
            "$ref": "#/components/schemas/PageMeta"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "meta"
